const costFactors = [
  {
    t: 'Which destination you choose',
    b: 'Distance drives the cost. Lake Naivasha and Hell&rsquo;s Gate sit around 90 to 100 km from Nairobi, Lake Nakuru around 160 km and Amboseli around 240 km, so the vehicle and guide hours differ substantially between them.',
