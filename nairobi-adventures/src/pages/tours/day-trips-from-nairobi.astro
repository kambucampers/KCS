const naivashaTwo = twoPersonFor('naivashaHellsGate');
const nakuruTwo = twoPersonFor('lakeNakuru');
const amboseliTwo = twoPersonFor('amboseli');
const naivashaSix = fromFor('naivashaHellsGate');

const itinerary = [
  {
    time: 'Before dawn',
    title: 'Early pick-up in Nairobi',
