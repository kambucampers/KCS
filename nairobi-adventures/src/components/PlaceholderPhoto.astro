---
/**
 * Marked photo slot. Swap the wrapper for <Image /> once real photography
 * is supplied; keep the `alt` text, it is already written for SEO.
 */
interface Props {
  alt: string;
  note: string;
  ratio?: string;
  tone?: 'sand' | 'ink' | 'acacia';
  class?: string;
}
const { alt, note, ratio = '4 / 3', tone = 'sand', class: className = '' } = Astro.props;
const tones = {
  sand: { bg: '#E8DFCE', fg: '#17513A', sky: '#F7F3EA', sun: '#E0A33E' },
  ink: { bg: '#14231C', fg: '#0d1712', sky: '#22382E', sun: '#E0A33E' },
  acacia: { bg: '#17513A', fg: '#0f3a29', sky: '#1F6B4B', sun: '#F2CE8C' },
} as const;
const c = tones[tone];
---

<figure class:list={['relative overflow-hidden', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt}>
  <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" class="h-full w-full" aria-hidden="true">
    <rect width="800" height="600" fill={c.sky} />
    <circle cx="620" cy="170" r="72" fill={c.sun} opacity="0.85" />
    <path d="M0 380c120-40 220 10 320-20s180-70 300-40 180 60 180 60v220H0Z" fill={c.bg} />
    <path d="M0 470c140-30 240 20 360-10s220-40 440 10v130H0Z" fill={c.fg} opacity="0.9" />
    <g fill={c.fg}>
      <path d="M120 470V360" stroke={c.fg} stroke-width="8" />
      <path d="M60 356c18-26 46-38 62-38s44 12 62 38c-24-10-40-14-62-14s-38 4-62 14Z" />
      <path d="M640 470V370" stroke={c.fg} stroke-width="6" />
      <path d="M596 366c14-20 34-30 46-30s32 10 46 30c-18-8-30-11-46-11s-28 3-46 11Z" />
    </g>
  </svg>
  <figcaption
    class="absolute bottom-0 left-0 right-0 bg-ink/80 px-4 py-2 text-[0.72rem] uppercase tracking-[0.14em] text-bone/85"
  >
    {note}
  </figcaption>
</figure>
