---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-bone/95 backdrop-blur-sm">
  <div class="hidden border-b border-ink/10 bg-ink text-bone md:block">
    <div class="wrap flex items-center justify-between py-2 text-[0.78rem] tracking-wide">
      <p class="text-bone/75">Guided excursions in Nairobi and day tours from the city</p>
      <p class="flex gap-1.5">
        <span>Bookings:</span>
        <a class="font-semibold text-marigold hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>

  <div class="wrap flex items-center justify-between gap-6 py-4">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} home`}>
      <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
        <circle cx="20" cy="20" r="19" fill="#17513A" />
        <circle cx="20" cy="15.5" r="6.5" fill="#E0A33E" />
        <path d="M2 30c5-6 10-6 14-2s9 5 14 0 8-4 8-4v16H2Z" fill="#14231C" opacity="0.85" />
      </svg>
      <span class="leading-none">
        <span class="block font-[var(--font-display)] text-[1.15rem] font-medium tracking-tight text-ink sm:text-[1.35rem]"
          >Nairobi Adventures</span
        >
        <span class="mt-0.5 hidden text-[0.68rem] uppercase tracking-[0.2em] text-slate-light sm:block"
          >Day tours &amp; park safaris</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.slice(1).map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative text-[0.95rem] font-medium text-ink/80 transition-colors hover:text-acacia',
              isActive(item.href) && 'text-acacia',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute -bottom-1.5 left-0 h-px w-full bg-marigold" aria-hidden="true" />
            )}
          </a>
        ))
      }
      <a href="/contact/" class="btn btn-solid px-5 py-2.5 text-[0.9rem]">Book a day tour</a>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="flex items-center gap-2 border border-ink/20 px-3 py-2 text-sm font-semibold text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
        <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.6" />
      </svg>
      Menu
    </button>
  </div>

  <div id="mobile-nav" class="hidden border-t border-ink/10 bg-bone lg:hidden">
    <nav class="wrap flex flex-col py-3" aria-label="Primary mobile">
      {
        nav.map((item) => (
          <>
            <a
              href={item.href}
              class:list={[
                'border-b border-ink/10 py-3 text-[1.05rem] font-medium',
                isActive(item.href) ? 'text-acacia' : 'text-ink',
              ]}
            >
              {item.label}
            </a>
            {item.children?.map((child) => (
              <a href={child.href} class="border-b border-ink/10 py-2.5 pl-4 text-[0.95rem] text-slate">
                {child.label}
              </a>
            ))}
          </>
        ))
      }
      <a href="/contact/" class="btn btn-solid mt-4 mb-2">Book a day tour</a>
      <a href={`mailto:${site.email}`} class="pb-3 text-center text-sm text-slate">{site.email}</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('menu-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!btn || !panel) return;
    btn.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
    });
  })();
</script>
