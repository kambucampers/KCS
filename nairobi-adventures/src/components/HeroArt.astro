---
/** Layered savannah-meets-skyline illustration, bottom-anchored behind the home hero. */
---

<svg
  viewBox="0 0 1200 700"
  preserveAspectRatio="xMidYMax meet"
  class="h-auto w-full"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="glow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#E0A33E" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#E0A33E" stop-opacity="0" />
    </linearGradient>
  </defs>

  <ellipse cx="900" cy="360" rx="360" ry="200" fill="url(#glow)" />
  <circle cx="900" cy="270" r="74" fill="#E0A33E" opacity="0.82" />

  <!-- distant city skyline -->
  <g fill="#0F1D17" opacity="0.7">
    <rect x="576" y="286" width="20" height="120" />
    <rect x="604" y="250" width="14" height="156" />
    <rect x="626" y="310" width="26" height="96" />
    <rect x="660" y="278" width="16" height="128" />
    <rect x="684" y="322" width="22" height="84" />
    <path d="M716 406V292l12-30 12 30v114Z" />
    <rect x="752" y="304" width="18" height="102" />
    <rect x="778" y="262" width="24" height="144" />
    <rect x="810" y="318" width="14" height="88" />
    <rect x="832" y="288" width="20" height="118" />
    <rect x="862" y="330" width="26" height="76" />
    <rect x="898" y="272" width="16" height="134" />
    <rect x="922" y="312" width="22" height="94" />
    <rect x="952" y="292" width="18" height="114" />
    <rect x="978" y="334" width="28" height="72" />
    <rect x="1014" y="300" width="16" height="106" />
    <rect x="1038" y="326" width="24" height="80" />
  </g>

  <!-- plains, front to back -->
  <path d="M0 406c160-30 280 16 440 4s300-32 420-18 340 26 340 26v282H0Z" fill="#17513A" opacity="0.92" />
  <path d="M0 494c200-32 330 18 500 4s310-30 460-14 240 24 240 24v192H0Z" fill="#123F2D" />
  <path d="M0 588c220-28 380 16 560 2s340-22 640-4v114H0Z" fill="#0E3223" />

  <!-- acacia trees -->
  <g fill="#0B2519">
    <rect x="1063" y="452" width="6" height="112" />
    <path d="M1004 452c16-30 40-44 62-44s46 14 62 44c-26-12-42-16-62-16s-36 4-62 16Z" />
    <rect x="712" y="516" width="5" height="82" />
    <path d="M668 516c12-23 30-33 46-33s34 10 46 33c-19-9-31-12-46-12s-27 3-46 12Z" />
    <rect x="196" y="486" width="4" height="70" />
    <path d="M160 486c10-19 24-27 38-27s28 8 38 27c-16-7-26-10-38-10s-22 3-38 10Z" />
  </g>

  <!-- grazing herd -->
  <g fill="#0B2519">
    <!-- giraffe -->
    <g transform="translate(846 452) scale(1.5)">
      <path d="M8 44h26c4 0 7 3 7 7v9h-4v-6H12v6H8Z" />
      <path d="M41 51 35 14c-1-5 2-9 6-9s7 3 7 8l-1 5 8-3 2 5-9 4-3 27Z" />
      <path d="M11 60V50h4v10Zm7 0V50h3v10Zm12 0V50h4v10Zm7 0V50h3v10Z" />
      <path d="M8 44 4 56l3 1 5-11Z" />
    </g>
    <!-- zebra -->
    <g transform="translate(966 552) scale(1.05)">
      <path d="M2 30v-10c0-5 4-9 9-9h22c5 0 8 2 10 6l8-5 2 5-7 5v18h-5V26H9v22H4Z" />
      <path d="M13 48v-9h4v9Zm20 0v-9h4v9Z" />
    </g>
    <g transform="translate(560 596) scale(0.85)">
      <path d="M2 30v-10c0-5 4-9 9-9h22c5 0 8 2 10 6l8-5 2 5-7 5v18h-5V26H9v22H4Z" />
      <path d="M13 48v-9h4v9Zm20 0v-9h4v9Z" />
    </g>
  </g>
</svg>
