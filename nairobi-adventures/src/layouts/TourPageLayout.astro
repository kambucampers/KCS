---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import PriceTable from '../components/PriceTable.astro';
import { site, type Tour } from '../data/site';
import { tableFor, fromFor, options, type OptionKey } from '../data/pricing';

interface Props {
  tour: Tour;
  title: string;
  description: string;
  h1: string;
  lede: string;
  heroMeta: { label: string; value: string }[];
  included: string[];
  notIncluded: string[];
  itinerary: { time: string; title: string; body: string }[];
  costFactors: { t: string; b: string }[];
  faqs: { q: string; a: string }[];
  photo: string;
  priceKeys: OptionKey[];
  priceNote?: string;
  ctaTitle: string;
  ctaBody: string;
}

const {
  tour, title, description, h1, lede, heroMeta, included, notIncluded,
  itinerary, costFactors, faqs, photo, priceKeys, priceNote, ctaTitle, ctaBody,
} = Astro.props;

const url = `${site.url}/tours/${tour.slug}/`;

const allPrices = priceKeys.flatMap((k) => tableFor(k).map((r) => r.perPerson));
const lowPrice = Math.min(...allPrices);
const highPrice = Math.max(...allPrices);
const fromPriceValue = Math.min(...priceKeys.map((k) => fromFor(k)));

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Tours', item: `${site.url}/tours/` },
      { '@type': 'ListItem', position: 3, name: tour.title, item: url },
    ],
  },
  {
    '@type': 'Product',
    '@id': `${url}#product`,
    name: tour.title,
    description,
    brand: { '@id': `${site.url}/#organization` },
    category: 'Guided day tour',
    url,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice,
      highPrice,
      offerCount: priceKeys.length * 6,
      availability: 'https://schema.org/InStock',
      seller: { '@id': `${site.url}/#organization` },
      description: `Price per person, ${priceKeys
        .map((k) => options[k].name.toLowerCase())
        .join(' or ')}, including ${priceKeys.map((k) => options[k].feeNote).join(' and ')}.`,
    },
  },
  {
    '@type': 'TouristTrip',
    '@id': `${url}#trip`,
    name: tour.title,
    description,
    touristType: tour.bestFor,
    provider: { '@id': `${site.url}/#organization` },
    itinerary: {
      '@type': 'ItemList',
      itemListElement: itinerary.map((step, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: step.title,
        description: step.body,
      })),
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero eyebrow="Day excursion" title={h1} lede={lede} meta={heroMeta} />

  <div class="wrap grid gap-14 py-16 md:grid-cols-12 md:py-24">
    <div class="md:col-span-7 lg:col-span-8">
      <Photo slot={photo} ratio="16 / 9" tone="acacia" />

      <div class="prose-na mt-12">
        <slot name="intro" />
      </div>

      <section class="mt-16">
        <h2 class="text-[length:var(--text-title)]">How the day runs</h2>
        <ol class="mt-8">
          {
            itinerary.map((step, i) => (
              <li class="border-t border-ink/15 py-6">
                <div class="grid gap-2 md:grid-cols-12 md:gap-8">
                  <p class="md:col-span-3 text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-acacia">
                    {step.time}
                  </p>
                  <div class="md:col-span-9">
                    <h3 class="text-[1.2rem] leading-snug">
                      <span class="mr-3 font-[var(--font-display)] text-[0.9rem] text-marigold">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      {step.title}
                    </h3>
                    <p class="mt-2 max-w-[62ch] text-slate" set:html={step.body} />
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-16 grid gap-10 border-t border-ink/15 pt-10 sm:grid-cols-2">
        <div>
          <h2 class="text-[1.35rem]">What is included</h2>
          <ul class="mt-5 space-y-3">
            {
              included.map((item) => (
                <li class="flex gap-3 text-[0.97rem] text-slate">
                  <span class="mt-2 h-px w-4 shrink-0 bg-acacia" aria-hidden="true" />
                  <span set:html={item} />
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="text-[1.35rem]">What is not included</h2>
          <ul class="mt-5 space-y-3">
            {
              notIncluded.map((item) => (
                <li class="flex gap-3 text-[0.97rem] text-slate">
                  <span class="mt-2 h-px w-4 shrink-0 bg-clay" aria-hidden="true" />
                  <span set:html={item} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="mt-16 border-t border-ink/15 pt-10" id="prices">
        <h2 class="text-[length:var(--text-title)]">Prices</h2>
        <p class="mt-4 max-w-[66ch] text-slate">
          Every price below is the full cost per person, entry fees included, for a private departure. The
          per-person figure falls as the group grows, because the vehicle and the guide are shared while the entry
          fees stay individual.
        </p>
        <div class="mt-8"><PriceTable keys={priceKeys} note={priceNote} /></div>
      </section>

      <div class="prose-na mt-16">
        <slot name="body" />
      </div>

      <section class="mt-16 border-t border-ink/15 pt-10">
        <h2 class="text-[length:var(--text-title)]">What affects the cost</h2>
        <p class="mt-4 max-w-[66ch] text-slate">
          The table above already reflects the two variables that move most, group size and the entry fees for the
          destination. These are the others, so nothing in your final confirmation comes as a surprise.
        </p>
        <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {
            costFactors.map((f) => (
              <div class="border-t border-ink/15 pt-5">
                <h3 class="text-[1.12rem] leading-snug">{f.t}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-slate" set:html={f.b} />
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-16 border-t border-ink/15 pt-10">
        <h2 class="text-[length:var(--text-title)]">Questions about this tour</h2>
        <div class="mt-6"><Faq items={faqs} /></div>
      </section>
    </div>

    <aside class="md:col-span-5 lg:col-span-4">
      <div class="sticky top-32 border border-ink/15 bg-sand/50 p-7">
        <p class="eyebrow">Book this day</p>
        <h2 class="mt-4 text-[1.5rem] leading-snug">Check a date for {tour.navTitle}</h2>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-slate">
          Send your dates, your pick-up address in Nairobi and how many travellers are coming. We reply with
          availability and the exact price for your group, usually the same day.
        </p>
        <p class="mt-6 border-t border-ink/15 pt-5">
          <span class="font-[var(--font-display)] text-[2rem] leading-none text-ink">${fromPriceValue}</span>
          <span class="text-[0.9rem] text-slate"> per person, entry fees included</span>
          <span class="mt-1 block text-[0.85rem] text-slate-light">
            at six travellers. <a class="underline underline-offset-4 hover:text-acacia" href="#prices">See every group size</a>
          </span>
        </p>
        <dl class="mt-6 space-y-3 border-t border-ink/15 pt-5 text-[0.9rem]">
          <div class="flex justify-between gap-4">
            <dt class="text-slate-light">Duration</dt>
            <dd class="text-right text-ink">{tour.duration}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-slate-light">Pick-up</dt>
            <dd class="text-right text-ink">{tour.pickup}</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-slate-light">Group</dt>
            <dd class="text-right text-ink">Private, your party only</dd>
          </div>
        </dl>
        <a href="/contact/" class="btn btn-primary mt-7 w-full">Request a booking</a>
        <a href={`mailto:${site.email}`} class="btn btn-outline mt-3 w-full text-[0.9rem]">Email us instead</a>
      </div>
    </aside>
  </div>

  <CtaBand title={ctaTitle} body={ctaBody} />
</BaseLayout>
