---
interface Props { heading?: string; body?: string; cta?: string; href?: string }
const {
  heading = 'One free morning is enough for a game drive',
  body = 'Send your dates and where you are staying, and you get a written reply with the timings, the vehicle and the total cost including park fees.',
  cta = 'Check availability for your dates',
  href = '/contact/',
} = Astro.props;
---
<section class="band-dark">
  <div class="shell relative grid gap-8 py-16 lg:grid-cols-[1.4fr_auto] lg:items-center lg:py-20">
    <div>
      <h2 class="max-w-2xl text-3xl leading-tight sm:text-4xl">{heading}</h2>
      <p class="mt-4 max-w-xl leading-relaxed text-paper/75">{body}</p>
    </div>
    <a href={href} class="btn btn-primary btn-lg justify-self-start lg:justify-self-end">{cta}</a>
  </div>
</section>
