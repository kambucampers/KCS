---
import SceneArt from './SceneArt.astro';
import { categoryLabel, type Tour } from '../data/tours';
interface Props { tour: Tour; featured?: boolean }
const { tour, featured = false } = Astro.props;
---
<article class:list={['card card-hover group overflow-hidden', featured && 'sm:col-span-2']}>
  <a href={`/tours/${tour.slug}/`} class:list={['flex h-full flex-col', featured && 'sm:grid sm:grid-cols-2 sm:items-stretch']}>
    <div class:list={['relative overflow-hidden bg-sand', featured ? 'h-56 sm:h-full' : 'h-48']}>
      <SceneArt
        scene={tour.art}
        alt={`Illustration of the ${tour.short.toLowerCase()} tour in Nairobi`}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <span class="absolute left-4 top-4 rounded-pill bg-paper/95 px-3 py-1.5 text-2xs font-bold uppercase tracking-[0.12em] text-acacia-800">
        {categoryLabel[tour.category]}
      </span>
    </div>

    <div class:list={['flex h-full flex-col p-6', featured && 'sm:p-9']}>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem] font-semibold text-muted">
        <span class="text-amber-600">{tour.duration}</span>
        <span aria-hidden="true" class="h-1 w-1 rounded-full bg-ink/25"></span>
        <span>Hotel pickup</span>
      </div>

      <h3 class:list={['mt-3 text-xl leading-snug', featured && 'sm:text-3xl']}>{tour.h1}</h3>
      <p class:list={['mt-3 text-[0.9375rem] leading-relaxed text-ink-soft', featured && 'sm:text-base']}>{tour.cardLine}</p>

      <span class="mt-auto inline-flex items-center gap-2 pt-6 text-[0.9375rem] font-semibold text-acacia-800 group-hover:text-amber-600">
        See the full itinerary
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-1">
          <path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5" />
        </svg>
      </span>
    </div>
  </a>
</article>
