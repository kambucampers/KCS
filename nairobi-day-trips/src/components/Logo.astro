---
interface Props { class?: string; tone?: 'dark' | 'light' }
const { class: className = '', tone = 'dark' } = Astro.props;
const ink = tone === 'light' ? '#FBF6EE' : '#23201C';
const green = tone === 'light' ? '#CBE0D4' : '#14523C';
---
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width="34" height="34" class="shrink-0 sm:h-[38px] sm:w-[38px]" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="19" fill={green} />
    <circle cx="20" cy="15.5" r="6.5" fill="#E4572E" />
    <path d="M4 27c5.5 2.6 9.6-1.2 15-.6s9.6 3.4 17 1.2v8.2A19 19 0 0 1 20 39 19 19 0 0 1 4 30Z" fill={ink} opacity=".9"/>
    <path d="M11 26.5v-4.2M6.5 22.6c1.1-2.5 3.3-3.5 4.5-3.5s3.4 1 4.5 3.5c-1.6-.8-3-1.1-4.5-1.1s-2.9.3-4.5 1.1Z" stroke={ink} stroke-width="1.4" stroke-linecap="round" fill={ink}/>
  </svg>
  <span class="leading-none">
    <span class="block font-display text-[0.9375rem] font-semibold tracking-tight sm:text-[1.0625rem]" style={`color:${tone === 'light' ? '#fff' : '#23201C'}`}>Nairobi Day Trips</span>
    <span class="mt-0.5 hidden text-2xs font-semibold uppercase tracking-[0.16em] min-[380px]:block" style={`color:${tone === 'light' ? 'rgba(251,246,238,.6)' : '#6B6257'}`}>Half-day tours, 4 to 6 hours</span>
  </span>
</span>
